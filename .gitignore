# Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Override files
*_override.tf
*_override.tf.json

# Sensitive plan files
*.tfplan

# Optional local overrides for infra/localstack/docker-compose.yml (may hold a password)
infra/localstack/.env

# Generated archives
tmp/*.zip

# Local Glue JARs fetched by infra/localstack/fetch-jars.sh (binaries)
infra/localstack/jars/*.jar

# OS/editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
terraform.tfvars
