# Copy this file to `.env` (same directory) and fill in the values.
# `.env` is gitignored; this example is committed.
#
# docker compose reads `.env` automatically, so no flags are needed.

# Required. A LocalStack auth token -- the free tier still requires one.
# Create a free account at https://app.localstack.cloud and copy the token
# from Settings -> Auth Token.
LOCALSTACK_AUTH_TOKEN=

# Optional. Password for the local SQL Server container's `sa` login.
# It is only ever used on your machine; the default is a throwaway value.
MSSQL_SA_PASSWORD=MyPass123!

# Optional. Name of the local S3 bucket the jobs read/write.
BUCKET_NAME=ntaccelerate-hoang-985176

# Optional. Region the local stack pretends to run in.
AWS_DEFAULT_REGION=us-east-1

# Optional. Day 2 notification email. SES verifies both addresses at startup;
# LocalStack records the send but does not deliver it.
MAIL_SENDER=elt.sender@example.com
MAIL_RECEIVERS=elt.receiver@example.com
