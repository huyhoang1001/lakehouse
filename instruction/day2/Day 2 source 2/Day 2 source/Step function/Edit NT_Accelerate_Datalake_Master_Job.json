{
  "Comment": "A description of my state machine",
  "StartAt": "Read run_type from MASTER JOB CONFIG table",
  "States": {
    "Read run_type from MASTER JOB CONFIG table": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:377414509754:function:NT_Accelerate_Read_Run_Type:$LATEST",
        "Payload": {
          "p_masterjob_id": 1
        }
      },
      "ResultPath": "$.result",
      "OutputPath": "$",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "Check configuration is correct? STOP if Wrong Config"
    },
    "Check configuration is correct? STOP if Wrong Config": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.result.Payload.flag",
          "BooleanEquals": false,
          "Next": "Stop because of not configure yet"
        },
        {
          "Variable": "$.result.Payload.flag",
          "BooleanEquals": true,
          "Next": "Check run_type is NEW or RERUN"
        }
      ]
    },
    "Check run_type is NEW or RERUN": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.result.Payload.run_type",
          "StringEquals": "NEW",
          "Next": "Check JOB STATUS table"
        },
        {
          "Variable": "$.result.Payload.run_type",
          "StringEquals": "RERUN",
          "Next": "Run jobs in parallel"
        }
      ]
    },
    "Check JOB STATUS table": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "Payload.$": "$",
        "FunctionName": "arn:aws:lambda:us-east-1:377414509754:function:NT_Accelerate_Check_Job_Status:$LATEST"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "ResultPath": "$.jobstatus",
      "OutputPath": "$",
      "Next": "Still Failed Job In Previous Run?"
    },
    "Still Failed Job In Previous Run?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.jobstatus.Payload.FailedJobExisting",
          "BooleanEquals": true,
          "Next": "Update MasterJob Failed"
        },
        {
          "Variable": "$.jobstatus.Payload.FailedJobExisting",
          "BooleanEquals": false,
          "Next": "Truncate table JOB_STATUS"
        }
      ]
    },
    "Update MasterJob Failed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$",
      "Parameters": {
        "Payload": {
          "p_masterjob_id": 1,
          "p_run_date.$": "$.result.Payload.run_date",
          "p_status": "FAILED"
        },
        "FunctionName": "arn:aws:lambda:us-east-1:377414509754:function:NT_Accelerate_Update_MasterJob_Status:$LATEST"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "Fail",
      "ResultPath": null
    },
    "Truncate table JOB_STATUS": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$",
      "Parameters": {
        "Payload.$": "$",
        "FunctionName": "arn:aws:lambda:us-east-1:377414509754:function:NT_Accelerate_Truncate_Job_Status:$LATEST"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "Run jobs in parallel",
      "ResultPath": "$.result1"
    },
    "Fail": {
      "Type": "Fail"
    },
    "Stop because of not configure yet": {
      "Type": "Fail",
      "Error": "Stop because of not configure yet"
    },
    "Run jobs in parallel": {
