                  "--p_src_databaseName.$": "$.JobInfo.Payload.var_src_db",
                  "--p_src_tableName.$": "$.JobInfo.Payload.var_scr_table",
                  "--p_tar_databaseName.$": "$.JobInfo.Payload.var_trg_db",
                  "--p_tar_tablename.$": "$.JobInfo.Payload.var_trg_table"
                }
              },
              "End": true,
              "ResultPath": null,
              "OutputPath": "$"
            }
          }
        },
        {
          "StartAt": "Check Stg_Extract_Listing job",
          "States": {
            "Check Stg_Extract_Listing job": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "OutputPath": "$",
              "Parameters": {
                "FunctionName": "arn:aws:lambda:us-east-1:377414509754:function:NT_Accelerate_Is_Allow_Running:$LATEST",
                "Payload": {
                  "p_job_name": "jb_Stg_Extract_Listing",
                  "p_run_date.$": "$.result.Payload.run_date",
                  "p_run_type.$": "$.result.Payload.run_type"
                }
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 6,
                  "BackoffRate": 2
                }
              ],
              "ResultPath": "$.JobInfo",
              "Next": "Is Stg_Extract_Listing Ran?"
            },
            "Is Stg_Extract_Listing Ran?": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.JobInfo.Payload.is_ran",
                  "StringEquals": "Yes",
                  "Next": "Update Listing job status is SUCCEEDED"
                },
                {
                  "Variable": "$.JobInfo.Payload.is_ran",
                  "StringEquals": "No",
                  "Next": "Start Job jb_Stg_Extract_Listing"
                }
              ]
            },
            "Update Listing job status is SUCCEEDED": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "OutputPath": "$.Payload",
              "Parameters": {
                "FunctionName": "arn:aws:lambda:us-east-1:377414509754:function:NT_Accelerate_Update_Job_Status:$LATEST",
                "Payload": {
                  "JobName": "jb_Stg_Extract_Listing",
                  "BatchId.$": "$.result.Payload.batch_id",
                  "RunDate.$": "$.result.Payload.run_date"
                }
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 6,
                  "BackoffRate": 2
                }
              ],
              "End": true
            },
            "Start Job jb_Stg_Extract_Listing": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "jb_Stg_Extract_Listing",
                "Arguments": {
                  "--p_job_name.$": "$.JobInfo.Payload.var_job_name",
                  "--catalog_conn.$": "$.JobInfo.Payload.var_catalog_con",
                  "--p_is_incremental_load.$": "$.JobInfo.Payload.var_incremental_load",
                  "--p_batch_id.$": "$.result.Payload.batch_id",
                  "--p_region.$": "$.JobInfo.Payload.var_region",
                  "--p_run_date.$": "$.result.Payload.run_date",
                  "--p_src_databaseName.$": "$.JobInfo.Payload.var_src_db",
                  "--p_src_tableName.$": "$.JobInfo.Payload.var_scr_table",
                  "--p_tar_databaseName.$": "$.JobInfo.Payload.var_trg_db",
                  "--p_tar_tablename.$": "$.JobInfo.Payload.var_trg_table"
                }
              },
              "End": true,
              "ResultPath": null,
              "OutputPath": "$"
            }
          }
        }
      ],
      "ResultPath": "$.staging",
      "Next": "Update MasterJob SUCCEEDED",
      "OutputPath": "$",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Update Master Job Failed for failed job"
        }
      ]
    },
    "Update MasterJob SUCCEEDED": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:377414509754:function:NT_Accelerate_Update_MasterJob_Status:$LATEST",
        "Payload": {
          "p_masterjob_id": 1,
          "p_run_date.$": "$.result.Payload.run_date",
          "p_status": "SUCCEEDED"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "Send mail",
      "ResultPath": null
    },
    "Update Master Job Failed for failed job": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:377414509754:function:NT_Accelerate_Update_MasterJob_Status:$LATEST",
        "Payload": {
          "p_masterjob_id": 1,
          "p_run_date.$": "$.result.Payload.run_date",
          "p_status": "FAILED"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "Send Mail for Staging Jobs failed",
      "ResultPath": null
    },
    "Send Mail for Staging Jobs failed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "Payload.$": "$",
