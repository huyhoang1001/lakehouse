{
  "Comment": "A description of my state machine",
  "StartAt": "Read run_type from MASTER JOB CONFIG table",
  "States": {
    "Read run_type from MASTER JOB CONFIG table": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:377414509754:function:NT_Accelerate_Read_Run_Type:$LATEST",
        "Payload": {
          "p_masterjob_id": 2
        }
      },
      "ResultPath": "$.result",
      "OutputPath": "$",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "Check configuration is correct? STOP if Wrong Config"
    },
    "Check configuration is correct? STOP if Wrong Config": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.result.Payload.flag",
          "BooleanEquals": false,
          "Next": "Stop because of not configure yet"
        },
        {
          "Variable": "$.result.Payload.flag",
          "BooleanEquals": true,
          "Next": "Check run_type is NEW or RERUN"
        }
      ]
    },
    "Check run_type is NEW or RERUN": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.result.Payload.run_type",
          "StringEquals": "NEW",
          "Next": "Check Master Job Staging Ran"
        },
        {
          "Variable": "$.result.Payload.run_type",
          "StringEquals": "RERUN",
          "Next": "Parallel"
        }
      ]
    },
    "Check Master Job Staging Ran": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:377414509754:function:NT_Accelerate_Check_Staging_Master_Job_Status:$LATEST",
