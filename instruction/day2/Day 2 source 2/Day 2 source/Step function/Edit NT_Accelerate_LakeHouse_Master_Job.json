        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "Staging master job ran in day successfully? Yes: Running master job DW",
      "ResultPath": "$.StgStatus"
    },
    "Staging master job ran in day successfully? Yes: Running master job DW": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.StgStatus.Payload.flag",
          "BooleanEquals": false,
          "Next": "Staging master job not running yet"
        },
        {
          "Variable": "$.StgStatus.Payload.flag",
          "BooleanEquals": true,
          "Next": "Check JOB STATUS table"
        }
      ]
    },
    "Staging master job not running yet": {
      "Type": "Fail"
    },
    "Check JOB STATUS table": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "Payload.$": "$",
        "FunctionName": "arn:aws:lambda:us-east-1:377414509754:function:NT_Accelerate_Check_Job_Status:$LATEST"
